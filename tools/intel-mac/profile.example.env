# profile.example.env: ОБРАЗЕЦ профиля для onboard-intel-mac.sh. Все значения здесь вымышленные заглушки.
#
# Как пользоваться:
#   1. Скопируй файл в место ВНЕ репозитория (например ~/onboard-profile.env), права 600.
#   2. Замени каждое CHANGE_ME своим значением. Скрипт не стартует, пока осталась хоть одна заглушка.
#   3. Передай путь: --profile ~/onboard-profile.env (или ONBOARD_PROFILE=~/onboard-profile.env).
# Заполненный профиль НЕ коммить: в нём координаты твоего флота. Скрипт откажется от профиля, который отслеживает git.
#
# Формат: КЛЮЧ=значение, по одному на строку. Файл не исполняется: это данные. Кавычки вокруг значения можно,
# внутри значения нельзя кавычки, обратную косую и знак $ (кроме ведущего $HOME/ или ~/ у путей).
# Ключ можно не задавать, если фаза, которой он нужен, не запускается: каждая фаза требует только свои ключи.

# --- любая фаза ---
# Папка узла: вендорные бинарники (opt), бэкапы, клон telegram-mcp, заметка узла. «~/lab» здесь только пример.
NODE_DIR=CHANGE_ME

# --- github ---
# Имя и почта для git commit НА ЭТОЙ УЧЁТКЕ (твои, не автора набора). Для GitHub удобен адрес «<id>+<login>» на домене users.noreply.github.com.
GIT_NAME=CHANGE_ME
GIT_EMAIL=CHANGE_ME
# Аккаунт GitHub, в который должен войти gh. После входа скрипт сверяет login и не идёт дальше при расхождении.
GITHUB_LOGIN=CHANGE_ME

# --- telegram ---
# Префикс метки LaunchAgent демона (обратный домен, например org.example): метка будет <префикс>.telegram-mcp
LAUNCHD_PREFIX=CHANGE_ME
# id комнаты флота для проверки видимости (называет хаб). Можно не задавать: тогда проверка видимости = SKIP.
TGBUS_ROOM=CHANGE_ME

# --- syncthing (координаты называет хаб, не угадывай) ---
# Device ID хаба: 8 групп по 7 символов A-Z2-7 через дефис. До первого контакта с хабом ключ можно убрать:
# фаза поднимет демон, покажет Device ID этой машины и остановится со SKIP.
HUB_DEVICE_ID=CHANGE_ME
HUB_NAME=CHANGE_ME
# Волт: id папки у хаба и локальный путь (путь сохраняется в ~/.zshrc как есть).
VAULT_FOLDER_ID=CHANGE_ME
VAULT_ROOT=CHANGE_ME
# Куда принимать шару claude-imports.
IMPORTS_DIR=CHANGE_ME
# Слаг папки памяти, который назвал хаб (каталог ~/.claude/projects/<слаг>/memory).
MEMORY_SHARE_SLUG=CHANGE_ME
# Раскладка шины. Её решает хаб, скрипт не выбирает:
#   separate-share = шина едет отдельной шарой (нужны BUS_FOLDER_ID и BUS_DIR), а её каталог исключён в фильтре волта ДО приёма волта;
#   inside-vault   = шина едет внутри шары волта, отдельной папки нет.
BUS_LAYOUT=CHANGE_ME
BUS_FOLDER_ID=CHANGE_ME
# Локальный путь шины (при любой раскладке: он же уходит в MACHINE_BUS_DIR).
BUS_DIR=CHANGE_ME
# Whitelist claude-home: имена файлов и каталогов через пробел, которые РАЗРЕШЕНО принять из ~/.claude хаба.
# Всё остальное запрещено. Звёздочки, пути и имена с секретами (projects, secrets, settings*, .credentials*, .claude.json,
# state, browser-profiles) скрипт не примет. Точный перечень называет хаб.
CLAUDE_HOME_ALLOW=CHANGE_ME

# --- law ---
# Имя оператора (CLAUDE_OPERATOR) и имя узла, согласованное с хабом (MACHINE_KEY).
OPERATOR_NAME=CHANGE_ME
MACHINE_KEY=CHANGE_ME
# Каноническая рабочая папка Claude на узле: от неё Claude Code производит слаг каталога памяти.
CANON_CWD=CHANGE_ME
