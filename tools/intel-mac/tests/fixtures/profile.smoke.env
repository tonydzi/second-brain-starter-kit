# profile.smoke.env: ВЫМЫШЛЕННЫЙ заполненный профиль для тестов (tests/kill_gates.sh, tools/runbook_smoke.sh).
# Ни одного настоящего значения: имена, почта, id и пути придуманы. Для своей машины бери ../../profile.example.env.
NODE_DIR=$HOME/lab
OPERATOR_NAME=Test Operator
MACHINE_KEY=TestNode1
GIT_NAME=Test Operator
GIT_EMAIL=operator@example.com
GITHUB_LOGIN=example-operator
HUB_DEVICE_ID=AAAAAAA-BBBBBBB-CCCCCCC-DDDDDDD-EEEEEEE-FFFFFFF-GGGGGGG-HHHHHHH
HUB_NAME=hub
VAULT_FOLDER_ID=vault
VAULT_ROOT=$HOME/Obsidian/Vault
IMPORTS_DIR=$HOME/Obsidian/_imports
MEMORY_SHARE_SLUG=hub-project
CANON_CWD=$HOME/work
BUS_LAYOUT=separate-share
BUS_FOLDER_ID=machine-bus
BUS_DIR=$HOME/Obsidian/Vault/_machine-bus
CLAUDE_HOME_ALLOW=CLAUDE.md AGENTS.md canon rules commands
TGBUS_ROOM=-1001
LAUNCHD_PREFIX=org.example
